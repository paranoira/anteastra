---
import "../styles/global.css";
---
<!doctype html>
<html lang="hu">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07111f" />
    <meta
      name="description"
      content="Timee – gyors hely-, idő- és időjárási segéd amatőr csillagászoknak."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>Timee – csillagászati gyorssegéd</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Ugrás a tartalomhoz</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Timee kezdőlap">
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span>
            <strong>Timee</strong>
            <small>csillagászati gyorssegéd</small>
          </span>
        </a>

        <div class="header-tools">
          <div class="utc-clock" aria-label="Aktuális UTC idő">
            <span>UTC</span>
            <strong id="header-utc">--:--:--</strong>
          </div>
          <button class="icon-button" id="red-mode-button" type="button" aria-pressed="false">
            <span aria-hidden="true">●</span>
            <span class="button-label">Vörös mód</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="shell main-content">
      <section class="intro" aria-labelledby="page-title">
        <p class="eyebrow">Távcső-beállítás</p>
        <h1 id="page-title">Hely, idő és észlelési időjárás egy képernyőn.</h1>
        <p>
          GPS-helyzet, pontos koordináták, helyi és UTC-idő, valamint a következő
          órák felhőzete, szele és harmatveszélye – gyorsan, egy helyen.
        </p>
      </section>

      <section class="action-card" aria-labelledby="location-title">
        <div>
          <p class="eyebrow">Észlelőhely</p>
          <h2 id="location-title">Válaszd ki a helyszínt</h2>
          <p class="muted">
            A böngésző csak gombnyomásra kér helyhozzáférést. A helyzetet nem küldjük
            a Timee szerverére.
          </p>
        </div>
        <div class="primary-actions">
          <button class="button button-primary" id="gps-button" type="button">
            <span aria-hidden="true">⌖</span>
            Helyzetem használata
          </button>
          <button class="button button-secondary" id="toggle-manual-button" type="button" aria-expanded="false" aria-controls="manual-location">
            Koordináták megadása
          </button>
        </div>

        <form id="manual-location" class="manual-form" hidden>
          <label>
            Szélesség
            <input id="latitude-input" name="latitude" type="number" min="-90" max="90" step="any" inputmode="decimal" placeholder="47.5480" required />
          </label>
          <label>
            Hosszúság
            <input id="longitude-input" name="longitude" type="number" min="-180" max="180" step="any" inputmode="decimal" placeholder="18.7200" required />
          </label>
          <button class="button button-primary" type="submit">Helyszín alkalmazása</button>
        </form>

        <p id="status-message" class="status" role="status" aria-live="polite">
          Még nincs kiválasztott helyszín.
        </p>
      </section>

      <section id="weather-card" class="weather-card" aria-labelledby="weather-title">
        <div class="weather-heading">
          <div>
            <p class="eyebrow">Következő 12 óra</p>
            <h2 id="weather-title">Észlelési időjárás</h2>
          </div>
          <div class="weather-heading-actions">
            <span id="weather-status-badge" class="weather-status" data-state="idle">Nincs adat</span>
            <button class="button button-quiet" id="refresh-weather-button" type="button" disabled>
              Frissítés
            </button>
          </div>
        </div>

        <p id="weather-summary" class="weather-summary">
          Válassz helyszínt az előrejelzéshez.
        </p>

        <div class="weather-metrics" aria-label="Aktuális időjárási adatok">
          <article class="weather-metric">
            <span>Állapot</span>
            <strong id="weather-condition">—</strong>
            <small>Modell szerinti aktuális helyzet</small>
          </article>
          <article class="weather-metric">
            <span>Felhőzet</span>
            <strong id="weather-cloud">—</strong>
            <small id="weather-cloud-layers">Alacsony / közép / magas: —</small>
          </article>
          <article class="weather-metric">
            <span>Hőmérséklet</span>
            <strong id="weather-temperature">—</strong>
            <small>A kiválasztott helyen</small>
          </article>
          <article class="weather-metric">
            <span>Szél</span>
            <strong id="weather-wind">—</strong>
            <small id="weather-wind-detail">Széllökés: —</small>
          </article>
          <article class="weather-metric">
            <span>Páratartalom</span>
            <strong id="weather-humidity">—</strong>
            <small id="weather-dewpoint">Harmatpont: —</small>
          </article>
          <article class="weather-metric weather-metric-dew">
            <span>Harmatveszély</span>
            <strong id="weather-dew-risk" data-state="unknown">—</strong>
            <small>A hőmérséklet és a harmatpont közelsége alapján</small>
          </article>
        </div>

        <div id="weather-hourly" class="weather-hourly" role="list" aria-label="Órás előrejelzés">
          <p class="weather-empty">Válassz helyszínt az előrejelzéshez.</p>
        </div>

        <div class="weather-footer">
          <p id="weather-updated">—</p>
          <p>Az összegzés felhőzet, csapadékesély és szél alapján készült; a helyi viszonyok eltérhetnek.</p>
        </div>
      </section>

      <div class="dashboard-grid">
        <section class="data-card data-card-wide" aria-labelledby="coordinates-title">
          <div class="card-heading">
            <div>
              <p class="eyebrow">Pozíció</p>
              <h2 id="coordinates-title">Koordináták</h2>
            </div>
            <span id="location-source" class="badge">Nincs adat</span>
          </div>

          <dl class="data-list coordinates-list">
            <div>
              <dt>Decimális fok</dt>
              <dd id="decimal-coordinates">—</dd>
            </div>
            <div>
              <dt>Fok–perc–másodperc</dt>
              <dd id="dms-coordinates">—</dd>
            </div>
            <div>
              <dt>GPS-pontosság</dt>
              <dd id="accuracy-value">—</dd>
            </div>
            <div>
              <dt>Tengerszint feletti magasság</dt>
              <dd id="elevation-value">—</dd>
            </div>
          </dl>

          <div class="card-actions">
            <button class="button button-quiet" id="copy-decimal-button" type="button" disabled>
              Decimális másolása
            </button>
            <button class="button button-quiet" id="copy-dms-button" type="button" disabled>
              DMS másolása
            </button>
          </div>
        </section>

        <section class="data-card" aria-labelledby="local-time-title">
          <div class="card-heading">
            <div>
              <p class="eyebrow">Kiválasztott hely</p>
              <h2 id="local-time-title">Helyi idő</h2>
            </div>
          </div>
          <time id="local-clock" class="large-clock">--:--:--</time>
          <p id="local-date" class="date-line">—</p>
        </section>

        <section class="data-card" aria-labelledby="utc-time-title">
          <div class="card-heading">
            <div>
              <p class="eyebrow">Egyezményes világidő</p>
              <h2 id="utc-time-title">UTC</h2>
            </div>
          </div>
          <time id="utc-clock" class="large-clock">--:--:--</time>
          <p id="utc-date" class="date-line">—</p>
        </section>

        <section class="data-card data-card-wide" aria-labelledby="timezone-title">
          <div class="card-heading">
            <div>
              <p class="eyebrow">Időbeállítás</p>
              <h2 id="timezone-title">Időzóna</h2>
            </div>
          </div>
          <dl class="data-list timezone-list">
            <div>
              <dt>IANA időzóna</dt>
              <dd id="timezone-name">—</dd>
            </div>
            <div>
              <dt>UTC-eltérés</dt>
              <dd id="utc-offset">—</dd>
            </div>
            <div>
              <dt>Rövidítés</dt>
              <dd id="timezone-abbreviation">—</dd>
            </div>
            <div>
              <dt>Nyári időszámítás</dt>
              <dd id="dst-status">—</dd>
            </div>
          </dl>
          <div class="card-actions">
            <button class="button button-quiet" id="copy-setup-button" type="button" disabled>
              Teljes beállítás másolása
            </button>
          </div>
        </section>
      </div>

      <aside class="privacy-note">
        <strong>Adatkezelés:</strong> a mentett helyszín csak ebben a böngészőben marad.
        Az időzóna, a becsült magasság és az időjárás meghatározásához a koordinátát
        az Open-Meteo szolgáltatás kapja meg.
      </aside>

      <section class="coming-next" aria-labelledby="next-title">
        <p class="eyebrow">Következő lépések</p>
        <h2 id="next-title">Erre épül majd a teljes észlelési gyorspanel.</h2>
        <div class="feature-chips" aria-label="Tervezett funkciók">
          <span>Napnyugta és szürkület</span>
          <span>Holdfázis és holdkelte</span>
          <span>Seeing és átlátszóság</span>
          <span>Mentett észlelőhelyek</span>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <span>Timee</span>
        <span>Gyors segéd amatőr csillagászoknak.</span>
      </div>
    </footer>

    <script>
      import { initApp } from "../scripts/app.js";
      initApp();
    </script>
  </body>
</html>
